# Local secrets for the RAN Drift Guard demo.
# Copy to .env and fill in values. Do not commit .env.

# NVIDIA build platform key. Auto-detected by `openshell provider create
# --type nvidia --from-existing`, then injected into the sandbox at runtime.
NVIDIA_API_KEY=

# OpenShell provider + sandbox names. Used by scripts/openshell-bootstrap.sh
# and by the host-side bridge when calling `openshell sandbox exec`.
OPENSHELL_PROVIDER_NAME=nvidia-build
OPENSHELL_SANDBOX_NAME=ran-drift-demo

# Nemotron model routed through OpenShell's inference proxy.
OPENSHELL_INFERENCE_MODEL=nvidia/nemotron-3-super-120b-a12b

# OpenShell's local inference endpoint. The agent inside the sandbox calls
# this URL; the gateway adds credentials and forwards to NVIDIA's backend.
OPENSHELL_INFERENCE_URL=https://inference.local/v1

# Host-side bridge port. The Vite UI calls this endpoint from the browser.
LIVE_BRIDGE_PORT=8787
