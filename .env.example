# Local secrets for the live NemoClaw demo.
# Copy to .env and fill in values. Do not commit .env.

NVIDIA_API_KEY=

# build.nvidia.com model routed through NemoClaw/OpenShell.
NEMOCLAW_PROVIDER=nvidia
NEMOCLAW_MODEL=nvidia/nemotron-3-super-120b-a12b
NEMOCLAW_POLICY_TIER=restricted

# Name to display and target from the live bridge after onboarding.
NEMOCLAW_SANDBOX=ran-drift-demo

# Host-side live bridge port. The Vite UI calls this endpoint from the browser.
LIVE_BRIDGE_PORT=8787

# Optional command override. Keep {prompt} where the scenario prompt should be inserted.
NEMOCLAW_AGENT_CMD=
